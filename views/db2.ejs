<!Doctype html>
<html>

<head>
    <meta charset="utf-8">
    <title>飲み物</title>
</head>

<body>
    <h2>飲み物詳細</h2>
    <table>
        <tr><th>ID</th><th>飲み物コード</th><th>商品名</th></tr>
        <% for( let row of data ) { %>
            <tr><td><%= row.id %></td>
                <td><%= row.code %></td>
                <td><%= row.name %></td></tr>
        <% } %>
    </table>
</body>
</html>
